import random


class GuessGame:
    def __init__(self):
        self.target_number = random.randint(1, 20)
        self.attempts_left = 5

    def ask_number(self):
        while True:
            try:
                return int(input())
            except ValueError:
                print("Пожалуйста, введите целое число.")

    def check_number(self, num):
        if num == self.target_number:
            print("Ты угадал! 🎉")
            return True
        elif num < self.target_number:
            print("Моё число больше, попробуй снова.")
        else:
            print("Моё число меньше, попробуй снова.")
        return False

    def start(self):
        print("Я загадал число от 1 до 20.")
        print(f"У тебя {self.attempts_left} попыток.\n")

        attempt = 1

        while self.attempts_left > 0:
            print(f"Попытка {attempt}: ", end="")
            user_num = self.ask_number()

            if self.check_number(user_num):
                return

            self.attempts_left -= 1
            attempt += 1
            print()

        print(f"Попытки закончились. Загаданное число: {self.target_number}")


if __name__ == "__main__":
    game = GuessGame()
    game.start()
